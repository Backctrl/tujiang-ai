# Local, single-operator development only. Copy to .env and supply your values.
DATABASE_URL=postgresql://tujiang:tujiang_local@127.0.0.1:55432/tujiang
# Explicit test database for the PostgreSQL integration suite; keep separate from production.
TEST_DATABASE_URL=
BACKEND_API_TOKEN=
BACKEND_ACTOR_ID=lishuo
PORT=3100
OBJECT_DIR=.data/objects
# Optional local JSON catalog containing only manually verified rules. Omit for an empty catalog.
# PRODUCTION_CATALOG_PATH=.data/production-catalog.json
# Leave empty to run health/domain APIs without model calls. Agent requests fail explicitly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional per-Skill overrides; empty values use OPENROUTER_MODEL.
OPENROUTER_FACT_MODEL=
OPENROUTER_PLAN_MODEL=
OPENROUTER_TIMEOUT_MS=60000
# Required explicit per-attempt policy before real generation. No authorization is implied.
OPENROUTER_PROVIDER=
OPENROUTER_MAX_INPUT_TOKENS=64000
OPENROUTER_MAX_OUTPUT_TOKENS=6000
OPENROUTER_MAX_COST_USD=0.05
OPENROUTER_ACCEPT_ESTIMATED_BUDGET=false
